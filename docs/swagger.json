{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "basePath": "/",
    "paths": {
        "/api/v1/pods/browser": {
            "post": {
                "description": "Creates a browser sandbox pod directly without generating session connection parameters",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "pods"
                ],
                "summary": "Create a raw browser sandbox pod",
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/pods/office": {
            "post": {
                "description": "Creates an office sandbox pod directly without generating session connection parameters",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "pods"
                ],
                "summary": "Create a raw office sandbox pod",
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/sessions/browser": {
            "post": {
                "description": "New route for deploying and connecting to browser pod with RDP credentials",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sessions"
                ],
                "summary": "New route for deploying and connecting to browser pod with RDP credentials",
                "parameters": [
                    {
                        "description": "Session Deployment Request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/api.DeploySessionRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/api.DeploySessionResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/sessions/office": {
            "post": {
                "description": "New route for deploying and connecting to office pod with RDP credentials",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sessions"
                ],
                "summary": "New route for deploying and connecting to office pod with RDP credentials",
                "parameters": [
                    {
                        "description": "Session Deployment Request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/api.DeploySessionRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/api.DeploySessionResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/sessions/{connectionID}/connect": {
            "get": {
                "description": "Returns the websocket URL and status for a given connection ID",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sessions"
                ],
                "summary": "Get WebSocket connection info for a session",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Connection ID",
                        "name": "connectionID",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.ConnectionResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/sessions/{connectionID}/share": {
            "get": {
                "description": "Enables sharing for the given connection ID and returns the shared websocket URL",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sessions"
                ],
                "summary": "Enable sharing for a session",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Connection ID",
                        "name": "connectionID",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.ConnectionResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/metrics/websocket": {
            "get": {
                "description": "Retrieve WebSocket metrics for all active sessions (for benchmarking)",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "metrics"
                ],
                "summary": "Get all WebSocket metrics",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "$ref": "#/definitions/api.WebSocketMetrics"
                            }
                        }
                    }
                }
            }
        },
        "/metrics/websocket/summary": {
            "get": {
                "description": "Retrieve aggregated WebSocket metrics across all sessions",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "metrics"
                ],
                "summary": "Get WebSocket metrics summary",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.WebSocketMetricsSummary"
                        }
                    }
                }
            }
        },
        "/sessions/{connectionID}/metrics": {
            "get": {
                "description": "Retrieve WebSocket RTT and traffic metrics for a session",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "metrics"
                ],
                "summary": "Get WebSocket metrics for a session",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Connection/Session ID",
                        "name": "connectionID",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.WebSocketMetrics"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Frontend clients report WebSocket RTT and traffic metrics",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "metrics"
                ],
                "summary": "Report WebSocket metrics for a session",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Connection/Session ID",
                        "name": "connectionID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "WebSocket Metrics",
                        "name": "metrics",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/api.WebSocketMetrics"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/sessions/{connectionID}/metrics/history": {
            "get": {
                "description": "Retrieve historical WebSocket RTT and traffic metrics snapshots",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "metrics"
                ],
                "summary": "Get WebSocket metrics history for a session",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Connection/Session ID",
                        "name": "connectionID",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/api.WebSocketMetrics"
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "api.ConnectionResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "websocket_url": {
                    "type": "string"
                }
            }
        },
        "api.DeploySessionRequest": {
            "type": "object",
            "properties": {
                "height": {
                    "type": "string"
                },
                "share": {
                    "description": "Added optional share field",
                    "type": "boolean"
                },
                "width": {
                    "type": "string"
                }
            }
        },
        "api.DeploySessionResponse": {
            "type": "object",
            "properties": {
                "connection_id": {
                    "type": "string"
                },
                "fqdn": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                },
                "podName": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "api.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        },
        "api.WebSocketMetrics": {
            "type": "object",
            "properties": {
                "errors": {
                    "type": "integer"
                },
                "rtt": {
                    "description": "RTT statistics in milliseconds",
                    "type": "object",
                    "properties": {
                        "avg": {
                            "type": "number"
                        },
                        "max": {
                            "type": "number"
                        },
                        "min": {
                            "type": "number"
                        },
                        "p50": {
                            "type": "number"
                        },
                        "p95": {
                            "type": "number"
                        },
                        "p99": {
                            "type": "number"
                        },
                        "samples": {
                            "type": "integer"
                        }
                    }
                },
                "session_id": {
                    "type": "string"
                },
                "timestamp": {
                    "type": "string"
                },
                "timing": {
                    "description": "Timing information",
                    "type": "object",
                    "properties": {
                        "connection_duration_ms": {
                            "type": "integer"
                        },
                        "connection_start_time": {
                            "type": "integer"
                        },
                        "last_message_time": {
                            "type": "integer"
                        }
                    }
                },
                "traffic": {
                    "description": "Traffic statistics",
                    "type": "object",
                    "properties": {
                        "bytes_received": {
                            "type": "integer"
                        },
                        "bytes_sent": {
                            "type": "integer"
                        },
                        "messages_received": {
                            "type": "integer"
                        },
                        "messages_sent": {
                            "type": "integer"
                        },
                        "total_bytes": {
                            "type": "integer"
                        }
                    }
                }
            }
        },
        "api.WebSocketMetricsSummary": {
            "type": "object",
            "properties": {
                "avg_rtt_ms": {
                    "type": "number"
                },
                "max_rtt_ms": {
                    "type": "number"
                },
                "min_rtt_ms": {
                    "type": "number"
                },
                "p95_rtt_ms": {
                    "type": "number"
                },
                "timestamp": {
                    "type": "string"
                },
                "total_bytes_received": {
                    "type": "integer"
                },
                "total_bytes_sent": {
                    "type": "integer"
                },
                "total_messages_received": {
                    "type": "integer"
                },
                "total_messages_sent": {
                    "type": "integer"
                },
                "total_rtt_samples": {
                    "type": "integer"
                },
                "total_sessions": {
                    "type": "integer"
                }
            }
        }
    }
}